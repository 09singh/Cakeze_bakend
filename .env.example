PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/cakezee
JWT_SECRET=replace-with-a-random-value-at-least-32-characters-long
JWT_EXPIRES_IN=7d
BUSINESS_TIMEZONE=Asia/Kolkata

# Email OTP verification (backend only)
SENDLIBERTY_API_KEY=replace-with-your-sendliberty-api-key
EMAIL_FROM="Cakezee <noreply@example.com>"
OTP_HASH_SECRET=replace-with-a-random-value-at-least-32-characters-long

# Firebase Admin SDK (backend only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# GA4 reporting (backend only)
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
